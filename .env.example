# MonadTrust environment. Everything here is optional: the site, the API and
# `npm run audit` work with no configuration, using Monad's public RPCs.

# RPC endpoints, comma-separated, tried in order. Leave blank for the defaults
# (mainnet: rpc.monad.xyz; testnet: testnet-rpc.monad.xyz, then Ankr). A free
# QuickNode or Dwellir endpoint is more reliable; an archive endpoint lets you
# re-run audits pinned to older blocks (`npm run audit -- 182 --block <n>`).
MONAD_MAINNET_RPC_URLS=
MONAD_RPC_URLS=

# How many reviewer wallets to read per audit (an even sample past this), and
# how many recent agent ids the directory scans (default: 20000 mainnet, 1500
# testnet). Lower them if your RPC rate-limits you.
# MAX_REVIEWERS=60
# SCAN_SPAN=1500

# ONLY needed to publish reviewer lists on-chain (npm run deploy:lists,
# npm run publish:lists). Use a throwaway wallet made with `npm run gen:wallet`
# and funded with a little MON. NEVER put a real wallet's key here, and never
# commit this file (.env is gitignored).
DEPLOYER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL: plain-English summaries written by an LLM (POST /api/explain).
# Without a key the app writes a deterministic summary itself. The model never
# changes a score; it only explains one. Any OpenAI-compatible API works; the
# defaults target Groq's free tier (https://console.groq.com).
LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
