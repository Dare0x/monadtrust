# MonadTrust environment (all optional for the web app).
#
# The web app and scoring engine work with NO configuration — they use the
# public Monad testnet RPC below by default. These vars only matter if you
# want to override the RPC or deploy the TrustRegistry contract yourself.

# Public Monad testnet RPC endpoints, comma-separated, tried in order. Leave
# blank to use the defaults (testnet-rpc.monad.xyz, then rpc.ankr.com). A free
# QuickNode or Dwellir endpoint (free for Metropolis teams) is more reliable.
MONAD_RPC_URLS=

# How many reviewer wallets to read per audit, and how many recent agents the
# directory scans. Lower them if your RPC rate-limits you.
# MAX_REVIEWERS=60
# SCAN_SPAN=1500

# ONLY needed to deploy the contract (npm run deploy:contract).
# Generate a throwaway testnet key with `npm run gen:wallet`, fund it at
# https://faucet.monad.xyz, and paste it here. NEVER use a real wallet key.
DEPLOYER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL: AI explanation layer (POST /api/explain).
#
# The app works with NO key: it falls back to a deterministic, plain-English
# summary (labeled "auto-generated", never "AI"). If you provide a FREE key
# below, the app instead uses a real LLM to narrate the score — the model can
# NEVER change the number, it only explains it.
#
# Recommended free provider (no credit card): Groq — https://console.groq.com
# Create a key, paste it as LLM_API_KEY. Defaults target Groq's OpenAI-compatible
# API. Any OpenAI-compatible endpoint works via LLM_BASE_URL / LLM_MODEL.
LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
